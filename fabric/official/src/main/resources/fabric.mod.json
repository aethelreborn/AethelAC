{
  "schemaVersion": 1,
  "id": "aethelac-fabric-official",
  "version": "${version}",
  "name": "AethelAC (Fabric, official mappings)",
  "description": "AethelAC anticheat for Minecraft 26.1-26.3. Official-mapped platform compiled directly against the deobfuscated 26.X jar, sibling to fabric-intermediary, which covers 1.16.1-1.21.11. Per-version submodules contribute aethel26MainLoad entrypoints.",
  "license": "GPLv3",
  "environment": "server",
  "entrypoints": {
    "preLaunch": [
      "ac.aethel.aethelac.platform.fabric.AethelACFabricOfficialEntryPoint"
    ],
    "main": [
      "ac.aethel.aethelac.platform.fabric.AethelACFabricOfficialEntryPoint"
    ]
  },
  "mixins": [
    "aethelac.mixins.json"
  ],
  "accessWidener": "aethelac.accesswidener",
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/level/Level": [
        "ac/aethel/aethelac/platform/api/world/PlatformWorld"
      ],
      "net/minecraft/world/entity/Entity": [
        "ac/aethel/aethelac/platform/fabric/inject/FabricEntityHandle"
      ],
      "net/minecraft/server/level/ServerPlayer": [
        "ac/aethel/aethelac/platform/fabric/inject/FabricServerPlayerHandle"
      ],
      "net/minecraft/server/MinecraftServer": [
        "ac/aethel/aethelac/platform/fabric/inject/FabricMinecraftServerHandle"
      ],
      "net/minecraft/commands/CommandSourceStack": [
        "ac/aethel/aethelac/platform/api/sender/Sender"
      ]
    }
  },
  "depends": {
    "minecraft": ">=26.1.2 <26.3",
    "java": ">=25",
    "fabricloader": ">=0.19",
    "fabric-lifecycle-events-v1": "*",
    "packetevents": "*"
  },
  "recommends": {
    "luckperms": "*"
  }
}
